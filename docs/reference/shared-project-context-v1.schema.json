{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devcrew.local/schemas/shared-project-context-v1.schema.json",
  "title": "DevCrew Shared Project Context v1 (manual, unverified)",
  "description": "Structure only. Valid contents are not execution attestation, user consent, credentials or trusted instructions. The runtime parser separately checks chronological expiry, exact keys, relative path segments, UTC canonicalization and UTF-8 byte bounds.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "contextId",
    "projectId",
    "taskId",
    "revision",
    "generatedAt",
    "expiresAt",
    "projectStateSource",
    "source",
    "targetProvider",
    "content"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "enum": [
        "handoff",
        "project-context"
      ]
    },
    "contextId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
    },
    "projectId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
    },
    "taskId": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d\\.\\d{3}Z$"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d\\.\\d{3}Z$"
    },
    "projectStateSource": {
      "const": "unavailable"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "runId",
        "provenance"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "enum": [
            "claude-code",
            "codex",
            "human",
            "other"
          ]
        },
        "runId": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "provenance": {
          "const": "manual_unverified"
        }
      }
    },
    "targetProvider": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "claude-code",
            "codex",
            "human",
            "other"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "goal",
        "completedClaims",
        "decisions",
        "relevantFiles",
        "evidenceRefs",
        "risks",
        "remainingWork",
        "nextAction"
      ],
      "properties": {
        "goal": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^[^\\u0000-\\u001f\\u007f\\u202a-\\u202e\\u2066-\\u2069]*$"
        },
        "completedClaims": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "^[^\\u0000-\\u001f\\u007f\\u202a-\\u202e\\u2066-\\u2069]*$"
          }
        },
        "decisions": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "^[^\\u0000-\\u001f\\u007f\\u202a-\\u202e\\u2066-\\u2069]*$"
          }
        },
        "relevantFiles": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "^[^\\u0000-\\u001f\\u007f\\u202a-\\u202e\\u2066-\\u2069]*$",
            "description": "Relative forward-slash path, further checked by runtime validator."
          }
        },
        "evidenceRefs": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "^[^\\u0000-\\u001f\\u007f\\u202a-\\u202e\\u2066-\\u2069]*$"
          }
        },
        "risks": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "^[^\\u0000-\\u001f\\u007f\\u202a-\\u202e\\u2066-\\u2069]*$"
          }
        },
        "remainingWork": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "^[^\\u0000-\\u001f\\u007f\\u202a-\\u202e\\u2066-\\u2069]*$"
          }
        },
        "nextAction": {
          "type": "string",
          "minLength": 0,
          "maxLength": 1024,
          "pattern": "^[^\\u0000-\\u001f\\u007f\\u202a-\\u202e\\u2066-\\u2069]*$"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "handoff"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "taskId": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
          },
          "targetProvider": {
            "type": "string",
            "enum": [
              "claude-code",
              "codex",
              "human",
              "other"
            ]
          },
          "content": {
            "properties": {
              "nextAction": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024,
                "pattern": "^[^\\u0000-\\u001f\\u007f\\u202a-\\u202e\\u2066-\\u2069]*$"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "project-context"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "targetProvider": {
            "type": "null"
          }
        }
      }
    }
  ]
}
